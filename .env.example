# Copy to .env only if configuring your own PostgreSQL/Neon database.
# npm run db:local creates a private .env automatically if none exists.
# Replace CHANGE_ME with your own credential. Never commit .env.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:55432/sanlian
SEED_DEMO=false
PORT=3000
# Hosting: NODE_ENV=production. Render supplies PORT and RENDER_EXTERNAL_URL.
# For another host or a custom domain, set APP_ORIGIN=https://your-actual-domain
# Production defaults to HOST=0.0.0.0. Local development stays on 127.0.0.1.
# TRUST_PROXY_HOPS: 0 locally, 1 on Render initially; verify the forwarding path
# with two clients during online acceptance before changing this value.
